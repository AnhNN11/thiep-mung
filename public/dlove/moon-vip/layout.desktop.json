      "viewBox": "0 0 1920 1080",
      "coordinateUnit": "reference-pixel"
    },
    "breakpoint": {
      "minWidthPx": 900,
      "recommendedMediaQuery": "(min-width: 900px) and (min-aspect-ratio: 4/3)"
    },
    "responsiveStrategy": {
      "fit": "cover",
      "alignment": "50% 50%",
      "safeAreaNormalized": {
        "x": 0.08,
        "y": 0.03,
        "width": 0.84,
        "height": 0.92
      },
      "note": "Render all layers in one SVG viewBox 0 0 1920 1080. Scale the SVG as a single scene; never stretch layers independently."
    },
    "containsTextLayer": false,
    "backgroundColor": "#050a14",
    "interactionTarget": "full-moon",
    "moonHint": {
      "text": "Ấn giữ vào mặt trăng",
      "baselineY": 466,
      "fontSizePx": 21
    }
  },
  "placementRules": {
    "box": {
      "description": "Render directly at boxPx."
    },
    "alpha-content-box": {
      "description": "targetContentBoxPx describes the visible alpha content. Compensate for transparent padding using asset.alphaContentRectPx.",
      "fit": "contain",
      "formula": {
        "scale": "min(target.width / alpha.width, target.height / alpha.height)",
        "renderWidth": "asset.width * scale",
        "renderHeight": "asset.height * scale",
        "renderX": "target.x + (target.width - alpha.width * scale) / 2 - alpha.x * scale",
        "renderY": "target.y + (target.height - alpha.height * scale) / 2 - alpha.y * scale"
      }
    }
  },
